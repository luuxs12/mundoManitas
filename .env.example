# =====================================================================
# Variables de entorno de Mundo Manitas
# Copia este archivo como .env y ajusta los valores antes de ejecutar
# con Docker Compose o con el perfil de producción.
# =====================================================================

# --- Base de datos PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/mundo_manitas
DB_USERNAME=postgres
DB_PASSWORD=cambiame

# En Docker Compose estos valores se usan para inicializar el contenedor.
POSTGRES_DB=mundo_manitas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiame

# --- Seguridad ---
# Clave de "recordarme" (cualquier cadena larga y aleatoria).
REMEMBER_ME_KEY=cambia-esta-clave-de-recordarme

# Secreto JWT: mínimo 32 caracteres.
JWT_SECRET=cambia-este-secreto-jwt-de-al-menos-32-caracteres

# Minutos de vigencia del token JWT.
JWT_EXPIRATION_MINUTES=120

# Política de bloqueo de cuentas.
SECURITY_MAX_INTENTOS=5
SECURITY_BLOQUEO_MINUTOS=15
SECURITY_PASSWORD_MIN_LENGTH=8

# --- HTTPS ---
# Activa SSL_ENABLED=true solo si el keystore está montado en el contenedor.
# Si TLS termina en un proxy inverso, deja SSL_ENABLED=false.
SSL_ENABLED=false
SSL_KEY_STORE=
SSL_KEY_STORE_PASSWORD=
SSL_KEY_STORE_TYPE=PKCS12
COOKIE_SECURE=true

# --- Aplicación ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
